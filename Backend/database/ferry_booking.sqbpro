    v.vessel_code,
    v.vessel_name,
    o.operator_name,
    v.vessel_type,
    v.passenger_capacity,
    v.vehicle_capacity,
    v.status
FROM vessels v
LEFT JOIN ferry_operators o
    ON v.operator_id = o.operator_id
ORDER BY v.vessel_id;</sql><current_tab id="0"/></tab_sql></sqlb_project>
